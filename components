              </span>
            </div>
          ))}
        </div>
      </Card>
    </div>
  );
}
"use client";

import { useState, useMemo } from "react";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import type { DailyMetrics } from "@/lib/mock-data";
import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer, Area, ComposedChart, Legend } from "recharts";
import { TrendingUp, AlertTriangle, CheckCircle } from "lucide-react";

interface ForecastTabProps {
  historicalData: DailyMetrics[];
}

type ForecastPeriod = 1 | 3 | 6;

const COLORS = {
  primary: "oklch(0.55 0.25 285)",
  violet: "oklch(0.50 0.28 300)",
  success: "oklch(0.60 0.18 165)",
  warning: "oklch(0.70 0.18 85)",
};

function generateForecast(historicalData: DailyMetrics[], months: number) {
  const recentData = historicalData.slice(-90);
  if (recentData.length === 0) {
    return { forecast: [], trend: 0, avgCandidates: 0, avgInterviews: 0 };
  }
  
  const avgCandidates = recentData.reduce((sum, d) => sum + (d.surveyCompletions || 0), 0) / recentData.length;
  const avgInterviews = recentData.reduce((sum, d) => sum + (d.scheduled || 0), 0) / recentData.length;
  
  // Тренд
  const firstHalf = recentData.slice(0, Math.floor(recentData.length / 2));
  const secondHalf = recentData.slice(Math.floor(recentData.length / 2));
  const firstAvg = firstHalf.length > 0 ? firstHalf.reduce((sum, d) => sum + (d.surveyCompletions || 0), 0) / firstHalf.length : 0;
  const secondAvg = secondHalf.length > 0 ? secondHalf.reduce((sum, d) => sum + (d.surveyCompletions || 0), 0) / secondHalf.length : 0;
  const trend = firstAvg > 0 ? (secondAvg - firstAvg) / firstAvg : 0;

  const forecast = [];
  const today = new Date();
  
  for (let i = 0; i < months * 30; i++) {
    const date = new Date(today);
    date.setDate(date.getDate() + i);
    
    const seasonality = 1 + 0.15 * Math.sin((date.getMonth() / 12) * 2 * Math.PI);
    const trendFactor = 1 + trend * (i / 30);
    const noise = 0.9 + Math.random() * 0.2;
    
    const predictedCandidates = Math.round(avgCandidates * seasonality * trendFactor * noise);
    const predictedInterviews = Math.round(avgInterviews * seasonality * trendFactor * noise);
    
    const uncertainty = 0.1 + (i / (months * 30)) * 0.2;
    
    forecast.push({
      date: date.toLocaleDateString("ru-RU", { day: "2-digit", month: "short" }),
      predicted: predictedCandidates,
      interviews: predictedInterviews,
      upper: Math.round(predictedCandidates * (1 + uncertainty)),
      lower: Math.round(predictedCandidates * (1 - uncertainty)),
    });
  }
  
  return { forecast, trend, avgCandidates, avgInterviews };
}

export function ForecastTab({ historicalData }: ForecastTabProps) {
  const [period, setPeriod] = useState<ForecastPeriod>(1);
  
  const { forecast, trend, avgCandidates, avgInterviews } = useMemo(
    () => generateForecast(historicalData, period),
    [historicalData, period]
  );

  const trendPercent = Number.isFinite(trend) ? (trend * 100).toFixed(1) : "0.0";
  const isPositiveTrend = trend >= 0;
  
  // Прогнозные итоги
  const totalPredicted = forecast.reduce((sum, d) => sum + d.predicted, 0);
  const totalInterviews = forecast.reduce((sum, d) => sum + d.interviews, 0);

  return (
    <div className="space-y-4">
      <div className="mb-2">
        <h2 className="text-lg font-semibold text-foreground">Прогноз нагрузки</h2>
        <p className="text-sm text-muted-foreground">AI-модель на основе исторических данных</p>
      </div>

      {/* Переключатель периода */}
      <div className="flex gap-2">
        {([1, 3, 6] as ForecastPeriod[]).map((p) => (
          <Button
            key={p}
            variant={period === p ? "default" : "outline"}
            size="sm"
            onClick={() => setPeriod(p)}
            className="flex-1"
          >
            {p} мес.
          </Button>
        ))}
      </div>

      {/* Тренд */}
      <Card className={`p-4 border ${isPositiveTrend ? "border-success/30 bg-success/5" : "border-warning/30 bg-warning/5"}`}>
        <div className="flex items-center gap-3">
          <div className={`p-2 rounded-full ${isPositiveTrend ? "bg-success/20" : "bg-warning/20"}`}>
            {isPositiveTrend ? (
              <TrendingUp className="w-5 h-5 text-success" />
            ) : (
              <AlertTriangle className="w-5 h-5 text-warning" />
            )}
          </div>
          <div>
            <p className="text-sm font-medium text-foreground">
              {isPositiveTrend ? "Растущий тренд" : "Снижающийся тренд"}
            </p>
            <p className="text-xs text-muted-foreground">
              {isPositiveTrend ? "+" : ""}{trendPercent}% за последние 3 месяца
            </p>
          </div>
        </div>
      </Card>

      {/* График прогноза */}
      <Card className="p-4 bg-card border-border">
        <h3 className="text-sm font-medium text-foreground mb-3">Прогноз кандидатов</h3>
        <div className="h-48">
          <ResponsiveContainer width="100%" height="100%">
            <ComposedChart data={forecast.filter((_, i) => i % Math.ceil(forecast.length / 30) === 0)}>
              <defs>
                <linearGradient id="confidence" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor={COLORS.primary} stopOpacity={0.3} />
                  <stop offset="95%" stopColor={COLORS.violet} stopOpacity={0} />
                </linearGradient>
              </defs>
              <XAxis
                dataKey="date"
                axisLine={false}
                tickLine={false}
                tick={{ fill: "hsl(0, 0%, 55%)", fontSize: 9 }}
                interval="preserveStartEnd"
              />
              <YAxis
                axisLine={false}
                tickLine={false}
                tick={{ fill: "hsl(0, 0%, 55%)", fontSize: 10 }}
                width={35}
              />
              <Tooltip
                contentStyle={{
                  backgroundColor: "white",
                  border: "1px solid oklch(0.90 0.02 285)",
                  borderRadius: "8px",
                  fontSize: 11,
                  boxShadow: "0 4px 12px rgba(0,0,0,0.1)",
                }}
              />
              <Area
                type="monotone"
                dataKey="upper"
                stroke="transparent"
                fill="url(#confidence)"
              />
              <Area
                type="monotone"
                dataKey="lower"
                stroke="transparent"
                fill="white"
              />
              <Line
                type="monotone"
                dataKey="predicted"
                stroke={COLORS.primary}
                strokeWidth={2}
                dot={false}
                name="Прогноз"
              />
            </ComposedChart>
          </ResponsiveContainer>
        </div>
        <p className="text-xs text-muted-foreground mt-2 text-center">
          Заштрихованная область — доверительный интервал
        </p>
      </Card>

      {/* Прогнозные итоги */}
      <div className="grid grid-cols-2 gap-3">
        <Card className="p-4 bg-card border-border">
          <div className="flex items-center gap-2 mb-2">
            <CheckCircle className="w-4 h-4 text-primary" />
            <p className="text-xs text-muted-foreground">Ожидается кандидатов</p>
          </div>
          <p className="text-2xl font-bold text-foreground">{totalPredicted.toLocaleString("ru-RU")}</p>
          <p className="text-xs text-muted-foreground">за {period} мес.</p>
        </Card>
        <Card className="p-4 bg-card border-border">
          <div className="flex items-center gap-2 mb-2">
            <CheckCircle className="w-4 h-4 text-success" />
            <p className="text-xs text-muted-foreground">Ожидается интервью</p>
          </div>
          <p className="text-2xl font-bold text-foreground">{totalInterviews.toLocaleString("ru-RU")}</p>
          <p className="text-xs text-muted-foreground">за {period} мес.</p>
        </Card>
      </div>

      {/* Рекомендации */}
      <Card className="p-4 bg-card border-border">
        <h3 className="text-sm font-medium text-foreground mb-3">Рекомендации</h3>
        <div className="space-y-2 text-sm text-muted-foreground">
          {isPositiveTrend ? (
            <>
              <p>• Подготовьте дополнительные слоты для интервью</p>
              <p>• Рассмотрите расширение команды рекрутеров</p>
              <p>• Оптимизируйте процесс первичного скрининга</p>
            </>
          ) : (
            <>
              <p>• Пересмотрите стратегию привлечения кандидатов</p>
              <p>• Проверьте эффективность источников трафика</p>
              <p>• Оцените конкурентность предложений</p>
            </>
          )}
        </div>
      </Card>
    </div>
  );
}
"use client";

import React from "react"

import { Card } from "@/components/ui/card";
import { TrendingUp, TrendingDown, Users, Calendar, MessageSquare, XCircle } from "lucide-react";
import type { AggregatedMetrics } from "@/lib/mock-data";

interface OverviewTabProps {
  metrics: AggregatedMetrics;
}

interface MetricCardProps {
  title: string;
  value: string | number;
  change?: number;
  icon: React.ReactNode;
  suffix?: string;
}

function safeNumber(value: number): number {
  return Number.isFinite(value) ? value : 0;
}

function MetricCard({ title, value, change, icon, suffix = "" }: MetricCardProps) {
  const safeChange = change !== undefined ? safeNumber(change) : undefined;
  const isPositive = safeChange !== undefined && safeChange >= 0;
  
  return (
    <Card className="p-4 bg-card border-border hover:border-primary/30 transition-colors">
      <div className="flex items-start justify-between mb-3">
        <div className="p-2 rounded-xl bg-primary/10">
          {icon}
        </div>
        {safeChange !== undefined && (
          <div className={`flex items-center gap-1 text-xs font-medium ${isPositive ? "text-success" : "text-destructive"}`}>
            {isPositive ? <TrendingUp className="w-3 h-3" /> : <TrendingDown className="w-3 h-3" />}
            {Math.abs(safeChange).toFixed(1)}%
          </div>
        )}
      </div>
      <div className="space-y-1">
        <p className="text-2xl font-bold text-foreground">
          {value}{suffix}
        </p>
        <p className="text-xs text-muted-foreground">{title}</p>
      </div>
    </Card>
  );
}

