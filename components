      </div>

      {/* Переключатель метрик */}
      <div className="flex gap-2">
        {(Object.keys(metricConfig) as MetricType[]).map((key) => (
          <Button
            key={key}
            variant={selectedMetric === key ? "default" : "outline"}
            size="sm"
            onClick={() => setSelectedMetric(key)}
            className="flex-1 text-xs"
          >
            {metricConfig[key].label}
          </Button>
        ))}
      </div>

      {/* График */}
      <Card className="p-4 bg-card border-border">
        <div className="h-48">
          <ResponsiveContainer width="100%" height="100%">
            <AreaChart data={chartData}>
              <defs>
                <linearGradient id={`gradient-${selectedMetric}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="5%" stopColor={current.color} stopOpacity={0.3} />
                  <stop offset="95%" stopColor={current.color} stopOpacity={0} />
                </linearGradient>
              </defs>
              <XAxis
                dataKey="date"
                axisLine={false}
                tickLine={false}
                tick={{ fill: "hsl(0, 0%, 55%)", fontSize: 10 }}
                interval="preserveStartEnd"
              />
              <YAxis
                axisLine={false}
                tickLine={false}
                tick={{ fill: "hsl(0, 0%, 55%)", fontSize: 10 }}
                width={35}
              />
              <Tooltip
                contentStyle={{
                  backgroundColor: "white",
                  border: "1px solid oklch(0.90 0.02 285)",
                  borderRadius: "8px",
                  fontSize: 12,
                  boxShadow: "0 4px 12px rgba(0,0,0,0.1)",
                }}
                labelStyle={{ color: "oklch(0.45 0.02 285)" }}
                formatter={(value: number) => [`${value}${current.suffix}`, current.label]}
              />
              <Area
                type="monotone"
                dataKey={selectedMetric}
                stroke={current.color}
                strokeWidth={2}
                fill={`url(#gradient-${selectedMetric})`}
              />
            </AreaChart>
          </ResponsiveContainer>
        </div>
      </Card>

      {/* Статистика */}
      <div className="grid grid-cols-3 gap-3">
        <Card className="p-3 bg-card border-border text-center">
          <p className="text-xs text-muted-foreground mb-1">Среднее</p>
          <p className="text-lg font-bold text-foreground">{avg.toFixed(1)}{current.suffix}</p>
        </Card>
        <Card className="p-3 bg-card border-border text-center">
          <p className="text-xs text-muted-foreground mb-1">Максимум</p>
          <p className="text-lg font-bold text-success">{max}{current.suffix}</p>
        </Card>
        <Card className="p-3 bg-card border-border text-center">
          <p className="text-xs text-muted-foreground mb-1">Минимум</p>
          <p className="text-lg font-bold text-destructive">{min}{current.suffix}</p>
        </Card>
      </div>

