}

type MetricType = "candidates" | "interviews" | "conversions";

const COLORS = {
  primary: "oklch(0.55 0.25 285)",
  violet: "oklch(0.50 0.28 300)",
  purpleLight: "oklch(0.65 0.20 285)",
};

export function DynamicsTab({ data, dateRange }: DynamicsTabProps) {
  const [selectedMetric, setSelectedMetric] = useState<MetricType>("candidates");

  const chartData = data.map((d) => ({
    date: new Date(d.date).toLocaleDateString("ru-RU", { day: "2-digit", month: "short" }),
    candidates: d.surveyCompletions || 0,
    interviews: d.scheduled || 0,
    conversions: d.surveyStarts > 0 ? Math.round((d.surveyCompletions / d.surveyStarts) * 100) : 0,
  }));

  const metricConfig = {
    candidates: { label: "Кандидаты", color: COLORS.primary, suffix: "" },
    interviews: { label: "Интервью", color: COLORS.violet, suffix: "" },
    conversions: { label: "Конверсия", color: COLORS.purpleLight, suffix: "%" },
  };

  const current = metricConfig[selectedMetric];

  // Статистика с защитой от NaN
  const values = chartData.map((d) => d[selectedMetric] as number).filter(v => Number.isFinite(v));
  const avg = values.length > 0 ? values.reduce((a, b) => a + b, 0) / values.length : 0;
