"use client";

import { useState } from "react";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Calendar, Users, Briefcase, Radio, X, Download, RotateCcw } from "lucide-react";
import type { DatePreset } from "@/lib/mock-data";

interface SettingsTabProps {
  datePreset: DatePreset;
  onDatePresetChange: (preset: DatePreset) => void;
  customDateRange: { start: Date; end: Date } | null;
  onCustomDateRangeChange: (range: { start: Date; end: Date } | null) => void;
  selectedVacancies: string[];
  onVacanciesChange: (vacancies: string[]) => void;
  selectedHRManagers: string[];
  onHRManagersChange: (managers: string[]) => void;
  selectedSources: string[];
  onSourcesChange: (sources: string[]) => void;
  vacancies: string[];
  hrManagers: string[];
  sources: string[];
  onReset: () => void;
  onExport: () => void;
}

const datePresets: { id: DatePreset; label: string }[] = [
  { id: "today", label: "Сегодня" },
  { id: "week", label: "Неделя" },
  { id: "month", label: "Месяц" },
  { id: "quarter", label: "Квартал" },
  { id: "year", label: "Год" },
];

export function SettingsTab({
  datePreset,
  onDatePresetChange,
  selectedVacancies,
  onVacanciesChange,
  selectedHRManagers,
  onHRManagersChange,
  selectedSources,
  onSourcesChange,
  vacancies,
  hrManagers,
  sources,
  onReset,
  onExport,
}: SettingsTabProps) {
  const [expandedSection, setExpandedSection] = useState<string | null>(null);

  const toggleSection = (section: string) => {
    setExpandedSection(expandedSection === section ? null : section);
  };

  const toggleItem = (
    item: string,
    selected: string[],
    onChange: (items: string[]) => void
  ) => {
    if (selected.includes(item)) {
      onChange(selected.filter((i) => i !== item));
    } else {
      onChange([...selected, item]);
    }
  };

  const activeFiltersCount = selectedVacancies.length + selectedHRManagers.length + selectedSources.length;

  return (
    <div className="space-y-4">
      <div className="mb-2">
        <h2 className="text-lg font-semibold text-foreground">Фильтры и настройки</h2>
        <p className="text-sm text-muted-foreground">Настройте отображение данных</p>
      </div>

      {/* Период */}
      <Card className="p-4 bg-card border-border">
        <div className="flex items-center gap-2 mb-3">
          <Calendar className="w-4 h-4 text-primary" />
          <h3 className="text-sm font-medium text-foreground">Период</h3>
        </div>
        <div className="grid grid-cols-5 gap-2">
          {datePresets.map((preset) => (
            <Button
              key={preset.id}
              variant={datePreset === preset.id ? "default" : "outline"}
              size="sm"
              onClick={() => onDatePresetChange(preset.id)}
              className="text-xs px-2"
            >
              {preset.label}
            </Button>
          ))}
        </div>
      </Card>

      {/* Вакансии */}
      <Card className="p-4 bg-card border-border">
        <button
          onClick={() => toggleSection("vacancies")}
          className="flex items-center justify-between w-full"
        >
          <div className="flex items-center gap-2">
            <Briefcase className="w-4 h-4 text-primary" />
            <h3 className="text-sm font-medium text-foreground">Вакансии</h3>
            {selectedVacancies.length > 0 && (
              <Badge variant="secondary" className="text-xs">
                {selectedVacancies.length}
              </Badge>
            )}
          </div>
          <span className="text-muted-foreground text-xs">
            {expandedSection === "vacancies" ? "Свернуть" : "Развернуть"}
          </span>
        </button>
        {expandedSection === "vacancies" && (
          <div className="mt-3 flex flex-wrap gap-2">
            {vacancies.map((vacancy) => (
              <Button
                key={vacancy}
                variant={selectedVacancies.includes(vacancy) ? "default" : "outline"}
                size="sm"
                onClick={() => toggleItem(vacancy, selectedVacancies, onVacanciesChange)}
                className="text-xs"
              >
                {vacancy}
              </Button>
            ))}
          </div>
        )}
      </Card>

      {/* HR-менеджеры */}
      <Card className="p-4 bg-card border-border">
        <button
          onClick={() => toggleSection("managers")}
          className="flex items-center justify-between w-full"
        >
          <div className="flex items-center gap-2">
            <Users className="w-4 h-4 text-primary" />
            <h3 className="text-sm font-medium text-foreground">HR-менеджеры</h3>
            {selectedHRManagers.length > 0 && (
              <Badge variant="secondary" className="text-xs">
                {selectedHRManagers.length}
              </Badge>
            )}
          </div>
          <span className="text-muted-foreground text-xs">
            {expandedSection === "managers" ? "Свернуть" : "Развернуть"}
          </span>
        </button>
        {expandedSection === "managers" && (
          <div className="mt-3 flex flex-wrap gap-2">
            {hrManagers.map((manager) => (
              <Button
                key={manager}
                variant={selectedHRManagers.includes(manager) ? "default" : "outline"}
                size="sm"
                onClick={() => toggleItem(manager, selectedHRManagers, onHRManagersChange)}
                className="text-xs"
              >
                {manager}
              </Button>
            ))}
          </div>
        )}
      </Card>

      {/* Источники */}
      <Card className="p-4 bg-card border-border">
        <button
          onClick={() => toggleSection("sources")}
          className="flex items-center justify-between w-full"
        >
          <div className="flex items-center gap-2">
            <Radio className="w-4 h-4 text-primary" />
            <h3 className="text-sm font-medium text-foreground">Источники</h3>
            {selectedSources.length > 0 && (
              <Badge variant="secondary" className="text-xs">
                {selectedSources.length}
              </Badge>
            )}
          </div>
          <span className="text-muted-foreground text-xs">
            {expandedSection === "sources" ? "Свернуть" : "Развернуть"}
          </span>
        </button>
        {expandedSection === "sources" && (
          <div className="mt-3 flex flex-wrap gap-2">
            {sources.map((source) => (
              <Button
                key={source}
                variant={selectedSources.includes(source) ? "default" : "outline"}
                size="sm"
                onClick={() => toggleItem(source, selectedSources, onSourcesChange)}
                className="text-xs"
              >
                {source}
              </Button>
            ))}
          </div>
        )}
      </Card>

      {/* Активные фильтры */}
      {activeFiltersCount > 0 && (
        <Card className="p-4 bg-secondary/50 border-border">
          <div className="flex items-center justify-between mb-2">
            <p className="text-sm font-medium text-foreground">Активные фильтры: {activeFiltersCount}</p>
            <Button variant="ghost" size="sm" onClick={onReset} className="text-xs h-7">
              <X className="w-3 h-3 mr-1" />
              Сбросить
            </Button>
          </div>
          <div className="flex flex-wrap gap-1">
            {selectedVacancies.map((v) => (
              <Badge key={v} variant="secondary" className="text-xs">
                {v}
              </Badge>
            ))}
            {selectedHRManagers.map((m) => (
              <Badge key={m} variant="secondary" className="text-xs">
                {m}
              </Badge>
            ))}
            {selectedSources.map((s) => (
              <Badge key={s} variant="secondary" className="text-xs">
                {s}
              </Badge>
            ))}
          </div>
        </Card>
      )}

      {/* Действия */}
      <div className="grid grid-cols-2 gap-3 pt-2">
        <Button variant="outline" onClick={onReset} className="gap-2 bg-transparent">
          <RotateCcw className="w-4 h-4" />
          Сбросить все
        </Button>
        <Button onClick={onExport} className="gap-2">
          <Download className="w-4 h-4" />
          Экспорт
        </Button>
      </div>
    </div>
  );
}
