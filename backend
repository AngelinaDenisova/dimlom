"""
Webhook router for receiving updates from HR bot
"""

from fastapi import APIRouter, Depends, Header, HTTPException, Request
from sqlalchemy.orm import Session
from datetime import datetime
from typing import Optional
import os
from dotenv import load_dotenv

from app.database import get_db
from app.models import Candidate, DailyMetrics
from app.schemas import WebhookResponse, WebhookEvent
from app.redis_client import delete_cache_pattern

load_dotenv()

router = APIRouter()

WEBHOOK_SECRET = os.getenv("TELEGRAM_WEBHOOK_SECRET", "")


def verify_webhook_secret(x_webhook_secret: Optional[str] = Header(None)) -> bool:
    """Verify webhook secret"""
    if not WEBHOOK_SECRET:
        return True  # Allow if not configured
    
    if x_webhook_secret != WEBHOOK_SECRET:
        raise HTTPException(status_code=403, detail="Invalid webhook secret")
    
    return True


@router.post("/update", response_model=WebhookResponse)
async def update_data(
    event: WebhookEvent,
    request: Request,
    db: Session = Depends(get_db),
    _: bool = Depends(verify_webhook_secret)
):
    """Receive webhook update from HR bot"""
    
    try:
        data = event.data
        event_type = event.event_type
        
        # Handle different event types
        if event_type == "candidate_created":
            candidate = Candidate(
                candidate_id=data.get("candidate_id"),
                vacancy_id=data.get("vacancy_id"),
                hr_manager_id=data.get("hr_manager_id"),
                source=data.get("source"),
                date=datetime.fromisoformat(data.get("date", datetime.now().isoformat())).date(),
                entered_bot=data.get("entered_bot", False),
                started_survey=data.get("started_survey", False),
                completed_survey=data.get("completed_survey", False),
                status=data.get("status")
            )
            db.add(candidate)
            db.commit()
            
        elif event_type in ["survey_started", "survey_completed", "interview_scheduled", 
                           "interview_cancelled", "candidate_rejected", "candidate_hired"]:
            # Update existing candidate
            candidate_id = data.get("candidate_id")
            candidate = db.query(Candidate).filter(Candidate.candidate_id == candidate_id).first()
            
            if candidate:
                if event_type == "survey_started":
                    candidate.started_survey = True
                elif event_type == "survey_completed":
                    candidate.completed_survey = True
                elif event_type == "interview_scheduled":
                    candidate.status = "scheduled"
                elif event_type == "interview_cancelled":
                    candidate.status = "cancelled"
                elif event_type == "candidate_rejected":
                    candidate.status = "rejected"
                elif event_type == "candidate_hired":
