router = APIRouter()


def _get_cache_key(endpoint: str, **kwargs) -> str:
    """Generate cache key"""
    key_data = json.dumps(kwargs, sort_keys=True, default=str)
    key_hash = hashlib.md5(key_data.encode()).hexdigest()
    return f"metrics:{endpoint}:{key_hash}"


@router.get("/dashboard", response_model=DashboardMetrics)
async def get_dashboard_metrics(
    start_date: Optional[date] = Query(None),
    end_date: Optional[date] = Query(None),
    vacancy_ids: Optional[List[str]] = Query(None),
    hr_manager_ids: Optional[List[str]] = Query(None),
    sources: Optional[List[str]] = Query(None),
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    """Get dashboard metrics"""
    start, end = validate_date_range(start_date, end_date)
    
    # Check cache
    cache_key = _get_cache_key("dashboard", start=start.isoformat(), end=end.isoformat(),
                               vacancy_ids=vacancy_ids, hr_manager_ids=hr_manager_ids, sources=sources)
    cached = await get_cache(cache_key)
    if cached:
        return DashboardMetrics(**cached)
    
    # Calculate metrics
    metrics = calculate_dashboard_metrics(
        db, start, end, vacancy_ids, hr_manager_ids, sources
    )
    
    # Cache result (5 minutes)
    await set_cache(cache_key, metrics.dict(), ttl=300)
    
    return metrics


