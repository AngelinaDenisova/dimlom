def validate_date_range(start_date: Optional[date], end_date: Optional[date]) -> tuple[date, date]:
    """Validate and return date range, defaulting to last month if not provided"""
    if not start_date or not end_date:
        end = date.today()
        start = date(end.year, end.month - 1, 1) if end.month > 1 else date(end.year - 1, 12, 1)
        return start, end
    
    if start_date > end_date:
        raise ValueError("start_date must be before end_date")
    
    return start_date, end_date


def validate_telegram_init_data(init_data: str, bot_token: str) -> bool:
    """Validate Telegram initData"""
    try:
        from urllib.parse import parse_qsl
        import hmac
        import hashlib
        
        parsed_data = dict(parse_qsl(init_data))
        received_hash = parsed_data.pop('hash', '')
        
        data_check_string = '\n'.join(
            f"{k}={v}" for k, v in sorted(parsed_data.items())
        )
        
        secret_key = hmac.new(
            key=b"WebAppData",
            msg=bot_token.encode(),
            digestmod=hashlib.sha256
        ).digest()
        
        calculated_hash = hmac.new(
            key=secret_key,
            msg=data_check_string.encode(),
            digestmod=hashlib.sha256
        ).hexdigest()
        
        return calculated_hash == received_hash
    except Exception:
        return False
