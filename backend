"""
Forecast service using time series analysis
"""

from sqlalchemy.orm import Session
from sqlalchemy import and_
from datetime import date, timedelta
from typing import List
from app.models import DailyMetrics
from app.schemas import ForecastDataPoint
import numpy as np
from typing import Tuple


def generate_forecast(
    db: Session,
    months: int,
    include_seasonality: bool = True,
    confidence_level: float = 0.95
) -> List[ForecastDataPoint]:
    """Generate forecast for specified months"""
    
    # Get historical data (last 90 days)
    end_date = date.today()
    start_date = end_date - timedelta(days=90)
    
    query = db.query(DailyMetrics).filter(
        and_(
            DailyMetrics.date >= start_date,
            DailyMetrics.date <= end_date
        )
    ).order_by(DailyMetrics.date)
    
    historical = query.all()
    
    if len(historical) < 30:
        return []
    
    # Extract time series
    dates = [m.date for m in historical]
    visits = [m.total_visits for m in historical]
    interviews = [m.scheduled for m in historical]
    
    # Simple linear regression with trend
    forecast_days = months * 30
    
    result = []
    for i in range(1, forecast_days + 1):
        forecast_date = end_date + timedelta(days=i)
        
        # Calculate trend
        n = len(visits)
        x = np.arange(n)
        y_visits = np.array(visits)
        y_interviews = np.array(interviews)
        
        # Linear regression
        slope_visits, intercept_visits = _linear_regression(x, y_visits)
        slope_interviews, intercept_interviews = _linear_regression(x, y_interviews)
        
        # Predict
        future_x = n + i
        predicted_visits = intercept_visits + slope_visits * future_x
        predicted_interviews = intercept_interviews + slope_interviews * future_x
        
        # Apply seasonality
        if include_seasonality:
            season_mult = _get_seasonal_multiplier(forecast_date)
            weekend_mult = 0.3 if forecast_date.weekday() >= 5 else 1.0
            predicted_visits *= season_mult * weekend_mult
            predicted_interviews *= season_mult * weekend_mult
        
        # Calculate confidence interval
        std_visits = np.std(y_visits)
        uncertainty = 0.1 + (i / forecast_days) * 0.2
        margin = std_visits * uncertainty * (1.96 if confidence_level == 0.95 else 2.58)
        
        lower_bound = max(0, int(predicted_visits - margin))
        upper_bound = int(predicted_visits + margin)
        
        # Estimate candidates (simplified)
        predicted_candidates = int(predicted_visits * 0.75 * 0.80)
        
        result.append(ForecastDataPoint(
            date=forecast_date.isoformat(),
            predicted_visits=max(0, int(predicted_visits)),
            lower_bound=lower_bound,
            upper_bound=upper_bound,
            predicted_interviews=max(0, int(predicted_interviews)),
            predicted_candidates=predicted_candidates
        ))
    
    return result


def _linear_regression(x: np.ndarray, y: np.ndarray) -> Tuple[float, float]:
    """Simple linear regression"""
    n = len(x)
    sum_x = np.sum(x)
    sum_y = np.sum(y)
    sum_xy = np.sum(x * y)
    sum_x2 = np.sum(x * x)
    
    denominator = n * sum_x2 - sum_x * sum_x
    if denominator == 0:
        return 0, np.mean(y)
    
    slope = (n * sum_xy - sum_x * sum_y) / denominator
    intercept = (sum_y - slope * sum_x) / n
    
    return slope, intercept


def _get_seasonal_multiplier(d: date) -> float:
    """Get seasonal multiplier for date"""
    seasonality = {
        0: 1.3,   # January
        1: 1.3,   # February
        2: 1.1,   # March
        3: 1.0,   # April
        4: 1.0,   # May
        5: 0.9,   # June
        6: 0.8,   # July
        7: 0.8,   # August
        8: 1.1,   # September
        9: 1.1,   # October
        10: 1.0,  # November
        11: 0.6,  # December
    }
    return seasonality.get(d.month - 1, 1.0)
