    8: 1.1,   # September
    9: 1.1,   # October
    10: 1.0,  # November
    11: 0.6,  # December
}


def get_seasonal_multiplier(d: date) -> float:
    """Get seasonal multiplier for date"""
    return SEASONALITY.get(d.month - 1, 1.0)


def generate_daily_metrics(db: Session, d: date) -> DailyMetrics:
    """Generate daily metrics for a date"""
    season_mult = get_seasonal_multiplier(d)
    weekend_mult = 0.3 if d.weekday() >= 5 else 1.0
    
    base_visits = 50 + random.randint(0, 30)
    total_visits = int(base_visits * season_mult * weekend_mult)
    
    # Conversion rates
    bot_entry_rate = 0.65 + random.uniform(0, 0.20)
    survey_start_rate = 0.70 + random.uniform(0, 0.20)
    survey_complete_rate = 0.70 + random.uniform(0, 0.20)
    
    bot_entries = int(total_visits * bot_entry_rate)
    survey_starts = int(bot_entries * survey_start_rate)
    survey_completions = int(survey_starts * survey_complete_rate)
    
    # Status distribution
    rejection_rate = 0.40 + random.uniform(0, 0.20)
    scheduled_rate = 0.20 + random.uniform(0, 0.20)
    cancellation_rate = 0.10 + random.uniform(0, 0.15)
    
    rejections = int(survey_completions * rejection_rate)
    scheduled = int(survey_completions * scheduled_rate)
    cancellations = int(scheduled * cancellation_rate)
    no_response = max(0, survey_completions - rejections - scheduled)
    hired = int((scheduled - cancellations) * (0.30 + random.uniform(0, 0.20)))
    
    return DailyMetrics(
        date=d,
        total_visits=total_visits,
        bot_entries=bot_entries,
        survey_starts=survey_starts,
        survey_completions=survey_completions,
        rejections=rejections,
        scheduled=scheduled,
        no_response=no_response,
        cancellations=cancellations,
        hired=hired
    )


def generate_candidates(db: Session, start_date: date, end_date: date, target_count: int = 5000):
    """Generate candidates for the period"""
    vacancies = db.query(Vacancy).all()
    if not vacancies:
        return
    
    current_date = start_date
    candidates_generated = 0
    
    while current_date <= end_date and candidates_generated < target_count:
        # Get daily metrics for this date
        daily_metric = db.query(DailyMetrics).filter(DailyMetrics.date == current_date).first()
        
        if daily_metric:
            # Generate candidates based on daily metrics
            for _ in range(daily_metric.survey_completions):
                if candidates_generated >= target_count:
                    break
                
                vacancy = random.choice(vacancies)
                source = random.choice(TRAFFIC_SOURCES)
                
                # Determine status
                status = None
                if random.random() < 0.4:  # 40% rejected
                    status = "rejected"
                elif random.random() < 0.7:  # 30% scheduled
                    status = "scheduled"
                    if random.random() < 0.15:  # 15% of scheduled get cancelled
                        status = "cancelled"
                elif random.random() < 0.9:  # 20% no response
                    status = "no_response"
                else:  # 10% hired
                    status = "hired"
                
                candidate = Candidate(
                    candidate_id=f"c{str(uuid.uuid4())[:8]}",
                    vacancy_id=vacancy.vacancy_id,
                    hr_manager_id=vacancy.hr_manager_id,
                    source=source,
                    date=current_date,
                    entered_bot=True,
                    started_survey=True,
                    completed_survey=True,
                    status=status
                )
                db.add(candidate)
                candidates_generated += 1
        
        current_date += timedelta(days=1)
    
    db.commit()
    print(f"Generated {candidates_generated} candidates")


