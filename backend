router = APIRouter()


@router.get("/pdf")
async def export_pdf(
    start_date: Optional[date] = Query(None),
    end_date: Optional[date] = Query(None),
    include_charts: bool = Query(True),
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    """Export data to PDF"""
    
    start, end = validate_date_range(start_date, end_date)
    
    # Query data
    query = db.query(DailyMetrics).filter(
        DailyMetrics.date >= start,
        DailyMetrics.date <= end
    ).order_by(DailyMetrics.date)
    
    metrics = query.all()
    
    if not metrics:
        raise HTTPException(status_code=404, detail="No data found for the specified period")
    
    # Create PDF
    buffer = BytesIO()
    doc = SimpleDocTemplate(buffer, pagesize=A4)
    elements = []
    
    styles = getSampleStyleSheet()
    title_style = ParagraphStyle(
        'CustomTitle',
        parent=styles['Heading1'],
        fontSize=24,
        textColor=colors.HexColor('#1a1a1a'),
        spaceAfter=30,
    )
    
    # Title
    elements.append(Paragraph("HR Analytics Report", title_style))
    elements.append(Paragraph(f"Period: {start} to {end}", styles['Normal']))
    elements.append(Spacer(1, 0.2 * inch))
    
    # Summary table
    totals = {
        "Total Visits": sum(m.total_visits for m in metrics),
        "Bot Entries": sum(m.bot_entries for m in metrics),
        "Survey Starts": sum(m.survey_starts for m in metrics),
        "Survey Completions": sum(m.survey_completions for m in metrics),
        "Interviews Scheduled": sum(m.scheduled for m in metrics),
        "Rejections": sum(m.rejections for m in metrics),
    }
    
    summary_data = [["Metric", "Value"]]
    for key, value in totals.items():
        summary_data.append([key, str(value)])
    
    summary_table = Table(summary_data, colWidths=[3 * inch, 2 * inch])
    summary_table.setStyle(TableStyle([
        ('BACKGROUND', (0, 0), (-1, 0), colors.grey),
        ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
        ('ALIGN', (0, 0), (-1, -1), 'LEFT'),
        ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
        ('FONTSIZE', (0, 0), (-1, 0), 12),
        ('BOTTOMPADDING', (0, 0), (-1, 0), 12),
        ('BACKGROUND', (0, 1), (-1, -1), colors.beige),
        ('GRID', (0, 0), (-1, -1), 1, colors.black)
    ]))
    
    elements.append(Paragraph("Summary", styles['Heading2']))
    elements.append(summary_table)
    elements.append(Spacer(1, 0.3 * inch))
    
    # Daily data table (first 30 days)
    daily_data = [["Date", "Visits", "Bot Entries", "Survey Starts", "Completions", "Interviews"]]
    for m in metrics[:30]:  # Limit to 30 rows
        daily_data.append([
            m.date.strftime("%Y-%m-%d"),
            str(m.total_visits),
            str(m.bot_entries),
            str(m.survey_starts),
            str(m.survey_completions),
            str(m.scheduled)
        ])
    
    daily_table = Table(daily_data, colWidths=[1 * inch, 0.8 * inch, 0.8 * inch, 0.8 * inch, 0.8 * inch, 0.8 * inch])
    daily_table.setStyle(TableStyle([
        ('BACKGROUND', (0, 0), (-1, 0), colors.grey),
        ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
        ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
        ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
        ('FONTSIZE', (0, 0), (-1, 0), 10),
        ('FONTSIZE', (0, 1), (-1, -1), 8),
        ('BOTTOMPADDING', (0, 0), (-1, 0), 12),
        ('BACKGROUND', (0, 1), (-1, -1), colors.beige),
        ('GRID', (0, 0), (-1, -1), 1, colors.black)
    ]))
    
    elements.append(Paragraph("Daily Metrics", styles['Heading2']))
    elements.append(daily_table)
    
    # Build PDF
    doc.build(elements)
    buffer.seek(0)
    
    filename = f"hr_analytics_report_{start}_{end}.pdf"
    
    return Response(
        content=buffer.read(),
        media_type="application/pdf",
        headers={"Content-Disposition": f"attachment; filename={filename}"}
    )


@router.get("/csv")
async def export_csv(
    start_date: Optional[date] = Query(None),
    end_date: Optional[date] = Query(None),
    format: str = Query("daily", regex="^(daily|weekly|monthly)$"),
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
