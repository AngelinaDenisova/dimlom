    # Query data
    query = db.query(DailyMetrics).filter(
        DailyMetrics.date >= start,
        DailyMetrics.date <= end
    ).order_by(DailyMetrics.date)
    
    metrics = query.all()
    
    if not metrics:
        raise HTTPException(status_code=404, detail="No data found for the specified period")
    
    # Create CSV
    output = StringIO()
    writer = csv.writer(output)
    
    # Write header
    writer.writerow([
        "Date", "Total Visits", "Bot Entries", "Survey Starts",
        "Survey Completions", "Interviews Scheduled", "Rejections",
        "No Response", "Cancellations", "Hired"
    ])
    
    # Write data
    for m in metrics:
        writer.writerow([
            m.date.isoformat(),
            m.total_visits,
            m.bot_entries,
            m.survey_starts,
            m.survey_completions,
            m.scheduled,
            m.rejections,
            m.no_response,
            m.cancellations,
            m.hired
        ])
    
    output.seek(0)
    filename = f"hr_analytics_{start}_{end}.csv"
    
    return Response(
        content=output.getvalue(),
        media_type="text/csv",
        headers={"Content-Disposition": f"attachment; filename={filename}"}
