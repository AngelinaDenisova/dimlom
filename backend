def calculate_dashboard_metrics(
    db: Session,
    start_date: date,
    end_date: date,
    vacancy_ids: Optional[List[str]] = None,
    hr_manager_ids: Optional[List[str]] = None,
    sources: Optional[List[str]] = None
) -> DashboardMetrics:
    """Calculate dashboard metrics for given period"""
    
    # Build query filters
    filters = [
        DailyMetrics.date >= start_date,
        DailyMetrics.date <= end_date
    ]
    
    # Query daily metrics
    query = db.query(DailyMetrics).filter(and_(*filters))
    daily_metrics = query.all()
    
    if not daily_metrics:
        return _empty_metrics(start_date, end_date)
    
    # Calculate totals
    totals = {
        "total_visits": sum(d.total_visits for d in daily_metrics),
        "bot_entries": sum(d.bot_entries for d in daily_metrics),
        "survey_starts": sum(d.survey_starts for d in daily_metrics),
        "survey_completions": sum(d.survey_completions for d in daily_metrics),
        "rejections": sum(d.rejections for d in daily_metrics),
        "scheduled": sum(d.scheduled for d in daily_metrics),
        "no_response": sum(d.no_response for d in daily_metrics),
        "cancellations": sum(d.cancellations for d in daily_metrics),
    }
    
    # Calculate conversions
    bot_conversion = (totals["survey_starts"] / totals["total_visits"] * 100) if totals["total_visits"] > 0 else 0
    survey_conversion = (totals["survey_completions"] / totals["survey_starts"] * 100) if totals["survey_starts"] > 0 else 0
    
    # Calculate previous period for comparison
    period_length = (end_date - start_date).days
    prev_end = start_date - timedelta(days=1)
    prev_start = prev_end - timedelta(days=period_length)
    
    prev_query = db.query(DailyMetrics).filter(
        and_(
            DailyMetrics.date >= prev_start,
            DailyMetrics.date <= prev_end
        )
    )
    prev_metrics = prev_query.all()
    
    prev_totals = {
        "total_visits": sum(d.total_visits for d in prev_metrics),
        "survey_starts": sum(d.survey_starts for d in prev_metrics),
        "survey_completions": sum(d.survey_completions for d in prev_metrics),
    }
    
    prev_bot_conversion = (prev_totals["survey_starts"] / prev_totals["total_visits"] * 100) if prev_totals["total_visits"] > 0 else 0
    prev_survey_conversion = (prev_totals["survey_completions"] / prev_totals["survey_starts"] * 100) if prev_totals["survey_starts"] > 0 else 0
    
    bot_conversion_change = bot_conversion - prev_bot_conversion
    survey_conversion_change = survey_conversion - prev_survey_conversion
    
    # Calculate distribution
    total_processed = totals["rejections"] + totals["scheduled"] + totals["no_response"]
    rejection_rate = (totals["rejections"] / total_processed * 100) if total_processed > 0 else 0
    scheduled_rate = (totals["scheduled"] / total_processed * 100) if total_processed > 0 else 0
    no_response_rate = (totals["no_response"] / total_processed * 100) if total_processed > 0 else 0
    
    # Calculate averages
    days_count = len(daily_metrics)
    avg_interviews_per_day = totals["scheduled"] / days_count if days_count > 0 else 0
    avg_cancellations_per_day = totals["cancellations"] / days_count if days_count > 0 else 0
    
    return DashboardMetrics(
        bot_conversion=round(bot_conversion, 2),
        bot_conversion_change=round(bot_conversion_change, 2),
        survey_conversion=round(survey_conversion, 2),
        survey_conversion_change=round(survey_conversion_change, 2),
        rejection_rate=round(rejection_rate, 2),
        scheduled_rate=round(scheduled_rate, 2),
        no_response_rate=round(no_response_rate, 2),
        avg_interviews_per_day=round(avg_interviews_per_day, 2),
        avg_cancellations_per_day=round(avg_cancellations_per_day, 2),
        total_candidates=totals["survey_completions"],
        total_interviews=totals["scheduled"],
        period={"start": start_date.isoformat(), "end": end_date.isoformat()}
    )


